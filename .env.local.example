# =========================================================================
# AI 團隊決策大腦 - 環境變數設定範本 (.env.local.example)
# 請複製此檔案並重新命名為 .env.local，然後填入您的金鑰。
# =========================================================================

# --- 1. AI 驅動大腦設定 ---
# 選擇您想使用的 AI 提供商。可選值: openai | gemini | anthropic | n8n | mock (預設)
# 若為 mock，系統會自動在本地端模擬 Erick 營運長的拆解與看板派發邏輯，不需消耗 Token，利於迅速展示與測試。
AI_PROVIDER=mock

# OpenAI 設定 (若使用 AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini 設定 (若使用 AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude 設定 (若使用 AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# n8n Webhook 串接設定 (若使用 AI_PROVIDER=n8n)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxx-xxxx-xxxx-xxxx

# --- 3. 實體行銷數據對接 API (可選) ---
# SEMrush API 金鑰 (用於 Iris 抓取台灣市場真實 SEO 搜尋量與競爭度)
SEMRUSH_API_KEY=YOUR_SEMRUSH_API_KEY_HERE

# DataForSEO API 認證 (Google Ads API 平替，用於 Iris 抓取真實搜尋量，最划算)
DATAFORSEO_API_LOGIN=YOUR_DATAFORSEO_API_LOGIN_HERE
DATAFORSEO_API_PASSWORD=YOUR_DATAFORSEO_API_PASSWORD_HERE

# Meta Marketing API 設定 (用於 Jack 抓取 FB/IG 廣告組合數據)
# 格式如：act_1234567890
META_AD_ACCOUNT_ID=YOUR_META_AD_ACCOUNT_ID_HERE
# 長效或系統用戶 Access Token
META_MARKETING_ACCESS_TOKEN=YOUR_META_MARKETING_ACCESS_TOKEN_HERE
